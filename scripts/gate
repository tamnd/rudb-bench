#!/bin/sh
# Run the gate somewhere that is not this machine, and skip it when nothing it checks changed.
#
# The development laptop is a 460 GB disk that sits above ninety percent full, and a target
# directory for this crate plus the engines it drives does not fit next to the other two
# workspaces. So the gate rsyncs the working tree to a Linux box and runs there, the same way
# tamnd/rudb does it.
#
#   scripts/gate              the gate on server3
#   scripts/gate server1      the same, on the box with the data on it
#
# This crate is one package, so there is no crate graph to narrow against the way rudb narrows.
# The one narrowing worth having is the common case: a change that is nothing but markdown does
# not need a compiler, and the prose test is a plain `cargo test --test style` away. A skipped
# check announces itself, every time, because a gate that silently narrows is a gate nobody can
# trust the green from.
set -e

host=server3
case "$1" in
  server1 | server2 | server3 | gamingpc) host=$1; shift ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
name=$(basename "$root")
remote="gate/$name"

# What changed, against the merge base with the trunk when there is one and against the previous
# commit when this is the trunk, plus whatever is uncommitted. The gate is run before the commit
# at least as often as after it.
base=$(git -C "$root" merge-base origin/main HEAD 2>/dev/null || git -C "$root" rev-parse HEAD~1 2>/dev/null || true)
if [ "$base" = "$(git -C "$root" rev-parse HEAD 2>/dev/null)" ]; then
  base=$(git -C "$root" rev-parse HEAD~1 2>/dev/null || true)
fi
changed=""
if [ -n "$base" ]; then
  changed=$(
    { git -C "$root" diff --name-only "$base...HEAD"
      git -C "$root" status --porcelain --untracked-files=all | cut -c4- | sed 's/.* -> //'
    } | sort -u | grep -v '^$' || true
  )
fi

code=yes
if [ -n "$base" ] && [ -n "$changed" ] && ! echo "$changed" | grep -qv '\.md$'; then
  code=no
fi

rsync -a --delete \
  --exclude '/target' \
  --exclude '/data' \
  --rsync-path "mkdir -p ~/$remote && rsync" \
  "$root/" "$host:$remote/"

if [ "$code" = no ]; then
  echo "only markdown changed, running the prose test and skipping the compiler"
  # shellcheck disable=SC2029
  ssh "$host" "export PATH=\$HOME/.cargo/bin:\$PATH; cd ~/$remote && cargo test --test style $*"
  exit 0
fi

# shellcheck disable=SC2029
ssh "$host" "export PATH=\$HOME/.cargo/bin:\$PATH; cd ~/$remote && \
  cargo fmt --all --check && \
  cargo clippy --all-targets --all-features -- -D warnings && \
  cargo test --all-features && \
  cargo doc --all-features --no-deps && \
  rustup run 1.85.0 cargo check --all-targets $*"
echo "everything the gate runs is green"
