+/// Resolve paths once for the schema, rather than search it for every chunk of every row group.
+struct SchemaIndex<'a> {
+    schema: &'a [SchemaColumn],
+    first: HashMap<&'a str, usize>,
+    unique: bool,
+}
+
+impl<'a> SchemaIndex<'a> {
+    fn new(schema: &'a [SchemaColumn]) -> Self {
+        let mut first = HashMap::with_capacity(schema.len());
+        for (at, column) in schema.iter().enumerate() {
+            first.entry(column.name.as_str()).or_insert(at);
+        }
+        let unique = first.len() == schema.len();
+        Self { schema, first, unique }
+    }
+
+    fn column(&self, name: &str, position: usize) -> Option<usize> {
+        // Writers ordinarily put chunks in schema order. Check the name even then, because a
+        // reordered row group must resolve by its path. Repeated names retain the old first-match
+        // behavior rather than claiming an ordinal the path cannot distinguish.
+        if self.unique && self.schema.get(position).is_some_and(|column| column.name == name) {
+            Some(position)
+        } else {
+            self.first.get(name).copied()
+        }
+    }
+}
